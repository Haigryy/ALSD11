# Contoh konfigurasi. Salin jadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
# File ini AMAN di-commit, jangan isi dengan nilai rahasia sungguhan.

# --- Praktikum 2: PokéAPI ---
# URL dasar API (tanpa garis miring di akhir)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
# Nilai awal, batas bawah, dan batas atas slider jumlah Pokémon
POKEMON_DEFAULT_LIMIT=10
POKEMON_MIN_LIMIT=5
POKEMON_MAX_LIMIT=30
# Batas waktu request dalam detik
REQUEST_TIMEOUT=10

# Praktikum 1 tidak butuh konfigurasi: file Excel diunggah lewat tampilan aplikasi.

# --- Jika nanti butuh API key, isi seperti ini (kosongkan di file contoh) ---
# API_KEY=isi_api_key_anda_di_sini
